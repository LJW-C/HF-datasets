# Track large dataset artifacts with Git LFS if they are committed.
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text

# Stable bytes for the scientific snapshot mapping on Windows and Linux.
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.cff text eol=lf
*.yml text eol=lf
LICENSE text eol=lf

# These archived text files must retain their original checksum bytes.
data/release_2.0.0-rc1/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
revision_v2/channel_validation.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
revision_v2/ofdm_identity_probe.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
revision_v2/DATA_CORRECTION_NOTICE.md -text whitespace=trailing-space,space-before-tab,cr-at-eol
